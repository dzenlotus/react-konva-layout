{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "jsx": "react-jsx",
    "paths": { "@layout/runtime": ["./src/lib/runtime.tsx"] },
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "skipLibCheck": true,
    "noEmit": true
  },
  "include": [
    "src",
    "vite.config.ts",
    "vite.lib.config.ts",
    "vite.react16.config.ts",
    "vite.react16-demo.config.ts"
  ],
  "exclude": ["src/react16"]
}
