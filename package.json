{
  "name": "@dzenlotus/react-konva-layout",
  "version": "0.6.1",
  "description": "Browser-native Flex and Grid layout for React Konva",
  "type": "module",
  "license": "MIT",
  "files": [
    "dist-lib",
    "README.md",
    "LICENSE"
  ],
  "main": "./dist-lib/react-konva-layout.js",
  "module": "./dist-lib/react-konva-layout.js",
  "types": "./dist-lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist-lib/index.d.ts",
      "import": "./dist-lib/react-konva-layout.js"
    }
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "build": "npm run typecheck && vite build && vite build --config vite.lib.config.ts && tsc -p tsconfig.lib.json",
    "preview": "vite preview --host 127.0.0.1",
    "prepare": "npm run build",
    "format": "prettier --write src README.md docs/embedded-layout.md *.json *.ts",
    "format:check": "prettier --check src README.md docs/embedded-layout.md *.json *.ts"
  },
  "peerDependencies": {
    "konva": "^10.0.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-konva": "^19.3.2"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "konva": "^10.9.0",
    "prettier": "3.9.10",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-konva": "^19.3.2",
    "typescript": "^7.0.2",
    "vite": "^8.3.4"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dzenlotus/react-konva-layout.git"
  },
  "homepage": "https://github.com/dzenlotus/react-konva-layout#readme",
  "bugs": {
    "url": "https://github.com/dzenlotus/react-konva-layout/issues"
  },
  "keywords": [
    "react",
    "konva",
    "flexbox",
    "grid",
    "canvas",
    "layout"
  ]
}
